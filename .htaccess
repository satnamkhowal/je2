# Jaipur Engineers clean public URLs
# Keep PHP files on disk; expose extensionless URLs to visitors and search engines.

Options -MultiViews
DirectoryIndex index.php

<IfModule mod_rewrite.c>
RewriteEngine On

# Canonical home URL: /index.php -> /
# Redirect only GET/HEAD so POST bodies are never lost.
RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$ [NC]
RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.php(?:[\s?]) [NC]
RewriteRule ^(.*/)?index\.php$ /$1 [R=301,L,NE]

# Canonical public URLs: /page.php -> /page
RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$ [NC]
RewriteCond %{THE_REQUEST} \s/+(.+?)\.php(?:[\s?]) [NC]
RewriteRule ^(.+)\.php$ /$1 [R=301,L,NE]

# Handle route/file collisions where an extensionless page name also exists as a directory.
# /courses serves courses.php, while /courses/... continues to use the real directory.
RewriteRule ^courses/?$ courses.php [L,QSA]

# Internally resolve /page to /page.php when that PHP file exists.
# Existing files and directories (assets, install, api, etc.) are left untouched.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.+?)/?$ $1.php [L,QSA]
</IfModule>
